# Environment variables — never commit secrets
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules/
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase CLI cache (machine specific)
supabase/.temp/

# Vercel CLI link
.vercel

# Deploy secrets, filled in by hand
.env.deploy

# MediaPipe wasm, copied from node_modules at build time (scripts/copy-mediapipe.mjs)
public/mediapipe/wasm/

# Photo eval: the model's raw answers (they can hold recipe text from real photos), and the
# lockfile Deno writes when the eval is run
test-imports/eval-raw.json
deno.lock

# Real photos used to test imports, and their ground truth: they stay on the machine that
# has them (the synthetic set and truth.json are committed)
test-imports/truth.local.json
test-imports/*.webp
test-imports/images.jpeg

# The production QA account's sign-in (qa@tryforka.com). Stays on this machine.
.qa-account.local

# Stripe sandbox and Resend keys for Phase 4 testing. Stay on this machine.
.billing.local

# Subagent worktrees
.claude/worktrees/
